{
  "name": "open-steamgate",
  "version": "0.0.1",
  "description": "Local /IWBEP/ OData v2 runtime for classic code-based SEGW services: transpile ABAP, Open SQL over SQLite, serve Fiori",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dsl:build": "node tools/dsl-build.mjs --check",
    "lint": "node tools/cds2ddic.mjs && node tools/stg-compile.mjs --all && abaplint",
    "bootstrap": "node tools/osd-bootstrap.mjs",
    "test:bootstrap-scratch": "node test/scratch/bootstrap.mjs",
    "pretranspile": "node tools/osd-node-check.mjs",
    "transpile": "node tools/osd-build.mjs",
    "rebuild": "node tools/osd-build.mjs --force",
    "builds": "node tools/osd-build.mjs list",
    "vsix": "node scripts/build-vsix.mjs",
    "vsix:marketplace": "OSD_VSIX_PROFILE=marketplace OSD_VSIX_PRERELEASE=1 node scripts/build-vsix.mjs",
    "prevsix": "node tools/osd-node-check.mjs",
    "vsix:install": "node scripts/install-vsix.mjs",
    "binary": "bun scripts/build-binary.mjs",
    "binary:sea": "bun scripts/build-sea.mjs sea",
    "binary:bundle": "bun scripts/build-sea.mjs bundle",
    "check:hosts": "node scripts/check-hosts.mjs '[\"node\",\"bin/osd.mjs\"]' '[\"build/osd\"]' '[\"build/osd-sea\"]'",
    "dev": "node tools/osd-build.mjs && STG_SERVE=child STG_DEV=1 node test/run.mjs",
    "ps": "node tools/osd-runtime.mjs ps",
    "dbs": "node tools/osd-db.mjs list",
    "unit": "npm run transpile && echo RUNNING && node tools/osd-unit-run.mjs",
    "integration": "node tools/osd-suites.mjs",
    "test": "npm run transpile && npm run lint && node tools/osd-unit-run.mjs && npm run integration",
    "test:bal-persist": "node test/bal-persist.mjs",
    "verify": "npm test && npm run e2e && npm run e2e:preview",
    "verify:showcase": "node scripts/verify-showcase.mjs",
    "start": "npm run transpile && node test/run.mjs",
    "example": "node tools/osd-example.mjs",
    "osd:serve": "npm run transpile && STG_SERVE=child STG_PORT=8099 node test/run.mjs",
    "zvdb:corpus": "node scripts/zvdb-corpus.mjs",
    "zvdb:massive": "node scripts/zvdb-massive.mjs",
    "zvdb:benchmark": "node scripts/zvdb-benchmark.mjs",
    "zvdb:oracle": "node scripts/zvdb-oracle.mjs",
    "osd:worktree": "node tools/osd-worktree.mjs",
    "osd:closure": "node tools/osd-closure.mjs",
    "osd:tls": "node tools/osd-tls.mjs",
    "osd:tls-proxy": "node tools/osd-tls-proxy.mjs",
    "conformance": "node test/conformance/run.mjs",
    "conformance:abapfs": "node tools/abapfs-conformance.mjs",
    "probe": "node tools/closure-probe.mjs",
    "amdp:oracle": "node tools/amdp-oracle.mjs",
    "amdp:demo": "node tools/amdp-demo.mjs",
    "e2e": "npm run transpile && playwright test",
    "e2e:workbench": "node test/e2e/workbench-w2.mjs",
    "e2e:isolated": "node scripts/run-e2e-isolated.mjs",
    "e2e:install": "playwright install chromium",
    "cds": "node tools/cds2ddic.mjs",
    "unit:file": "npm run transpile && rm -f .local/db/unit.sqlite* && echo RUNNING on a SQLite file && STG_DB=file STG_DB_PATH=.local/db/unit.sqlite node tools/osd-unit-run.mjs",
    "unit:duckdb": "npm run transpile && echo RUNNING on DuckDB && STG_DB=duckdb node tools/osd-unit-run.mjs",
    "unit:hana": "npm run transpile && echo RUNNING on HANA && STG_DB=hana node tools/osd-unit-run.mjs",
    "integration:duckdb": "STG_DB=duckdb mocha test/mocha.mjs",
    "start:duckdb": "npm run transpile && STG_DB=duckdb node test/run.mjs",
    "start:hana": "npm run transpile && STG_DB=hana node test/run.mjs",
    "web:preview": "node tools/osd-build.mjs --publish && node scripts/build-preview.mjs",
    "web:vscode": "node scripts/build-vscode-web.mjs",
    "web:vscode:test": "node scripts/test-web-probe.mjs",
    "web:preview:duckdb": "node tools/osd-build.mjs --publish && OSD_PREVIEW_DB=duckdb node scripts/build-preview.mjs",
    "web:serve": "node scripts/serve-build.mjs",
    "e2e:preview": "npm run web:preview && playwright test --config playwright.preview.config.mjs",
    "e2e:preview:duckdb": "npm run web:preview:duckdb && OSD_PREVIEW_DB=duckdb playwright test --config playwright.preview.config.mjs",
    "segw": "node tools/segw-registry.mjs",
    "segw:gen": "node tools/segw-gen.mjs",
    "segw:zip": "node tools/osd-abapgit-zip.mjs",
    "segw:shlp": "node tools/segw-shlp.mjs",
    "osd:fm": "node tools/osd-fm-registry.mjs",
    "osd:tran": "node tools/osd-tran-registry.mjs",
    "segw:tables": "node tools/segw-tables.mjs",
    "segw:tree": "node tools/segw-tree.mjs",
    "segw:cloud": "node tools/segw-cloud.mjs",
    "osd": "node tools/osd-store.mjs",
    "osd:xref": "node tools/osd-xref.mjs",
    "osd:sql": "node tools/osd-data.mjs",
    "osd:import": "node tools/osd-import.mjs",
    "osd:git": "node tools/osd-git.mjs",
    "osd:runtime": "node tools/osd-runtime.mjs",
    "osd:unit": "node tools/osd-unit.mjs",
    "osg:support": "node tools/osg-support.mjs",
    "osgo:unit": "node tools/osgo-unit.mjs",
    "osgb": "node tools/gogen/osabap.mjs",
    "osgjs:unit": "node tools/osgjs-unit.mjs",
    "bench:cube": "node tools/bench-cube.mjs",
    "stg:compile": "node tools/stg-compile.mjs",
    "segw:closure": "node tools/segw-closure.mjs",
    "packs:fetch": "node tools/osd-fetch.mjs",
    "transpiler:pin": "node tools/osd-transpiler-pin.mjs",
    "transpiler:which": "node tools/osd-transpiler.mjs",
    "transpiler:local": "node tools/osd-link.mjs transpiler packages/transpiler && node tools/osd-link.mjs transpiler-cli packages/cli",
    "transpiler:published": "npm install @abaplint/transpiler @abaplint/transpiler-cli && node tools/osd-transpiler.mjs",
    "runtime:local": "node tools/osd-link.mjs runtime packages/runtime",
    "runtime:published": "npm install @abaplint/runtime && node tools/osd-transpiler.mjs",
    "parked": "node tools/osd-parked.mjs",
    "leak": "node tools/osd-leak-scan.mjs .",
    "where": "node tools/osd-where-is.mjs",
    "notify:setup": "node tools/osd-telegram-notify.mjs setup",
    "notify:send-test": "node tools/osd-telegram-notify.mjs send-test",
    "notify:milestone": "node tools/osd-telegram-notify.mjs milestone",
    "naming": "node tools/osd-naming-scan.mjs",
    "replay": "node tools/osd-replay.mjs",
    "gateway:fixture": "node tools/osd-regression-fixture.mjs",
    "leak:all": "node tools/osd-leak-scan.mjs . --all",
    "osd:restart": "sh scripts/osd-restart.sh",
    "conformance:sqlscript": "node tools/sqlscript-conformance.mjs",
    "conformance:sqlscript:bun": "bun tools/sqlscript-conformance.mjs",
    "sqlscript:clauses": "node tools/sqlscript/clause-audit.mjs",
    "sql:compare": "node tools/osd-sql-trace.mjs",
    "sql:summary": "node tools/osd-sql-trace.mjs --summary",
    "branch": "node tools/osd-branch.mjs",
    "preview:closure": "node tools/osd-preview-closure.mjs",
    "queue": "node tools/osd-queue-check.mjs",
    "preflight": "node tools/osd-preflight.mjs",
    "bsp": "node tools/osd-bsp-registry.mjs"
  },
  "devDependencies": {
    "@abaplint/cli": "2.120.73",
    "@abaplint/core": "2.120.73",
    "@abaplint/database-pg": "^2.11.83",
    "@abaplint/database-sqlite": "^2.13.83",
    "@abaplint/runtime": "2.14.3",
    "@abaplint/transpiler": "2.14.3",
    "@abaplint/transpiler-cli": "2.14.3",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.20.2",
    "acorn": "^8.18.0",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "chai": "^5.3.3",
    "constants-browserify": "^1.0.0",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "express": "^4.22.2",
    "https-browserify": "^1.0.0",
    "mocha": "^11.7.6",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "sql.js": "^1.14.2",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "string_decoder": "^1.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "5.9.3",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.110.3"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "diff": "^7.0.0",
    "open-rfc": "^0.2.3",
    "parse5": "7.3.0"
  },
  "optionalDependencies": {
    "hdb": "^2.29.6"
  },
  "overrides": {
    "@abaplint/core": "$@abaplint/core"
  }
}
